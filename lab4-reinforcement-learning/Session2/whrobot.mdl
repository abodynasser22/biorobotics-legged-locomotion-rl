<?xml version="1.0" encoding="utf-8"?>
<chart id="18">
  <P Name="name">robot corners</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">18</P>
  <P Name="ssIdHighWaterMark">11</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">1</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">getcorners</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">18</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [cx,cy,collided] = getcorners(state,h,w,L, D)

% preallocate outputs
% cx = zeros(4,1);
% cy = zeros(4,1);

% extract individual components
x = state(1);
y = state(2);
s = state(3);
c = state(4);

% four corners
p = [h,-h,-h,h;w,w,-w,-w]/2;

% rotation matrix
M = [c,-s;s,c];

% rotate points
p = M*p;
% translate and extract x,y
cx = x*ones(1,4) + p(1,:);
cy = y*ones(1,4) + p(2,:);

% bottom obstacles
% corners of obstacle inside the robot (corner sideswipe)
collided = any(inpolygon([-L;L],[D;D],cx,cy));
% corner of robot inside obstacle(hit obstacle)
collided = collided || any((cy &lt; D) &amp; (abs(cx) &gt; L));
% vertical obstacle
% corners of obstacle inside the robot (corner sideswipe)
collided = collided || any(inpolygon([-L;L],3*[D;D],cx,cy));
% corner of robot inside obstacle(hit obstacle)
collided = collided || any((cy &gt; 3*D) &amp; (abs(cx) &lt; L));
</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="4" name="state">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="cx">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
