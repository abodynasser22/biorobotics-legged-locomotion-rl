      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [reward,isdone] = reward(observation, collided, action)

% out through the bottom?
y = observation(2);
madeit = (y &lt; -1.5);

% calculate reward value
reward = rewardfun(observation,action,madeit,collided);

% done if either failed (crashed) or succeeded
isdone = collided || madeit;
</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
        <P Name="vectorOutputs1D">1</P>
